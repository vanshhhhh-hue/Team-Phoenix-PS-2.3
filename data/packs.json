  "schema_version": 1,
  "packs": [
    {
      "id": "distribution",
      "title": "Distribute to every term",
      "subtitle": "Does the outside factor reach every term?",
      "parameters": {
        "a": 3,
        "b": 2
      },
      "original_template_id": "distribution_original",
      "faulty_rule_id": "multiply_first_only",
      "correct_rule_id": "multiply_every_term",
      "diagnostic_question_id": "dist_1",
      "reason_options": [
        {
          "id": "multiply_first_only",
          "text": "Multiply only the first term inside the bracket."
        },
        {
          "id": "multiply_every_term",
          "text": "Multiply every term inside the bracket."
        },
        {
          "id": "unsure",
          "text": "I guessed / used another reason"
        }
      ],
      "probe_question_id": "dist_2",
      "canonical_explanation": "The outside factor multiplies every term inside the bracket. In 3(x+2), three groups of x+2 contain 3x and 6, so the expansion is 3x+6.",
      "hint_ids": [
        "dist_hint1",
        "dist_hint2"
      ],
      "repair_question_id": "dist_3",
      "transfer_question_ids": [
        "dist_4",
        "dist_5"
      ],
      "delayed_question_ids": [
        "dist_6",
        "dist_7",
        "dist_8"
      ],
      "original_latex": "3(x+2)",
      "faulty_latex": "3x+2",
      "correct_latex": "3x+6",
      "faulty_rule_latex": "a(x+b)\\to ax+b",
      "correct_rule_latex": "a(x+b)\\to ax+ab",
      "repair_reason": "The outside factor multiplies every term."
    },
    {
      "id": "square",
      "title": "Keep the cross term",
      "subtitle": "What happens when both brackets multiply?",
      "parameters": {
        "b": 2
      },
      "original_template_id": "square_original",
      "faulty_rule_id": "square_terms_only",
      "correct_rule_id": "include_cross_term",
      "diagnostic_question_id": "sq_1",
      "reason_options": [
        {
          "id": "square_terms_only",
          "text": "Square each term and add; there is no cross term."
        },
        {
          "id": "include_cross_term",
          "text": "Multiply both brackets, including the two cross products."
        },
        {
          "id": "unsure",
          "text": "I guessed / used another reason"
        }
      ],
      "probe_question_id": "sq_2",
      "canonical_explanation": "A square of a sum means (x+b)(x+b). Multiplication gives x squared, two copies of bx, and b squared. For b=2 the missing cross term is 4x.",
      "hint_ids": [
        "sq_hint1",
        "sq_hint2"
      ],
      "repair_question_id": "sq_3",
      "transfer_question_ids": [
        "sq_4",
        "sq_5"
      ],
      "delayed_question_ids": [
        "sq_6",
        "sq_7",
        "sq_8"
      ],
      "original_latex": "(x+2)^2",
      "faulty_latex": "x^2+4",
      "correct_latex": "x^2+4x+4",
      "faulty_rule_latex": "(x+b)^2\\to x^2+b^2",
      "correct_rule_latex": "(x+b)^2\\to x^2+2bx+b^2",
      "repair_reason": "Both cross products must be included."
    },
    {
